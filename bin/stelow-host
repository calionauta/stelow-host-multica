#!/usr/bin/env python3
"""stelow-host-multica — provision stelow's workflow onto a Multica workspace.

Reads the host's opinion (config/columns.json), the pinned stelow stage model
(stages.yaml, fetched at the ref in stelow.lock.json) and drives the Multica CLI
to create skills, agents, the workflows and the project bindings.

    ./bin/stelow-host sync     # fetch + pin stages.yaml
    ./bin/stelow-host plan     # what would change (no writes)
    ./bin/stelow-host apply    # converge the workspace
    ./bin/stelow-host verify   # assert the live workspace matches the plan
    ./bin/stelow-host status   # compact live summary

Python 3 stdlib only. Every Multica call is a subprocess of the real CLI.
"""

from __future__ import annotations

import argparse
import copy
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CACHE = ROOT / ".stelow-cache"
LOCK = ROOT / "stelow.lock.json"
STAGES_MEMBER = "skills/stelow-workflow-orchestrator/stages.yaml"
CATALOG_MEMBER = "skills/stelow-workflow-orchestrator/stage-catalog.json"
TRANSITIONS_MEMBER = "skills/stelow-workflow-orchestrator/references/transitions.md"


def set_root(path: Path) -> None:
    """Relocate the tool: config/, agents/, stages/ and the cache follow the host.json location."""
    global ROOT, CACHE, LOCK
    ROOT = Path(path).resolve()
    CACHE = ROOT / ".stelow-cache"
    LOCK = ROOT / "stelow.lock.json"

# Built-in Multica statuses and lifecycle categories. A custom status key may
# not reuse one of these (server/internal/issuestatus).
RESERVED = {
    "backlog", "todo", "in_progress", "in_review", "blocked", "done", "cancelled",
    "unstarted", "started", "closed",
}
KEY_RE = re.compile(r"^[a-z0-9][a-z0-9_]{0,31}$")


class Fail(Exception):
    def __init__(self, message: str, code: int = 2):
        super().__init__(message)
        self.code = code


# --------------------------------------------------------------------------- io


def read_json(path: Path, what: str):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise Fail(f"{what} not found: {path}")
    except json.JSONDecodeError as exc:
        raise Fail(f"{what} is not valid JSON ({path}): {exc}")


def write_json(path: Path, payload) -> None:
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def say(msg: str = "") -> None:
    print(msg, flush=True)


# ---------------------------------------------------------------------- config


def load_host(path: Path) -> dict:
    """Config file, with environment overrides for the three ids.

    Ids are per-workspace, so keeping them out of a committed file is the normal
    case: export MULTICA_WORKSPACE_ID / MULTICA_RUNTIME_ID / MULTICA_PROJECT_ID
    and leave config/host.json as the template it is.
    """
    cfg = read_json(path, "config/host.json")
    for section in ("stelow", "multica", "agents"):
        if section not in cfg:
            raise Fail(f"config/host.json is missing '{section}'")
    for key, var in (("workspace_id", "MULTICA_WORKSPACE_ID"),
                     ("runtime_id", "MULTICA_RUNTIME_ID"),
                     ("project_id", "MULTICA_PROJECT_ID"),
                     ("bin", "MULTICA_BIN")):
        value = str(os.environ.get(var) or "").strip()
        if value:
            cfg["multica"][key] = value
    return cfg


ONLINE_STATES = ("online", "idle", "busy", "working")


def runtime_check(host: dict, multica) -> tuple[bool, str]:
    """Whether the runtime the agents are bound to can actually take a run.

    A stale runtime id is silent: apply succeeds, the board looks right, and
    every card sits there because the machine that owns the id is not the
    machine running the daemon.
    """
    runtime_id = host["multica"].get("runtime_id") or ""
    runtimes = {r.get("id"): r for r in multica.runtimes()}
    runtime = runtimes.get(runtime_id) or {}
    state = str(runtime.get("status") or "")
    ok = bool(runtime_id) and state.lower() in ONLINE_STATES
    return ok, f"{runtime.get('name') or runtime_id or '(unset)'} is {state or 'missing'}"


def missing_upstream(host: dict, skills: list[str]) -> list[str]:
    """Skills whose SKILL.md is not at the pinned path in the upstream repo.

    A name that looks right and is not there costs an import and half a
    provisioned workspace: skill import fails at the first bad name, after the
    good ones were already written.
    """
    repo = host["stelow"]["repo"]
    ref = host["stelow"]["ref"]
    root = host["stelow"].get("skill_root") or "skills"
    missing: list[str] = []
    for skill in skills:
        url = f"https://raw.githubusercontent.com/{repo}/{ref}/{root}/{skill}/SKILL.md"
        if upstream_status(url) != 200:
            missing.append(skill)
    return missing


def upstream_status(url: str) -> int:
    """200 or 404 from the pinned URL; a transport error is not a 404.

    A dropped connection used to read as "this skill does not exist", so one
    network blip blocked the first write with a message naming a skill that is
    perfectly fine. Retry once, then say what actually happened.
    """
    last: object = None
    for _ in range(2):
        try:
            with urllib.request.urlopen(url, timeout=20) as resp:  # noqa: S310 (pinned https host)
                return resp.status
        except urllib.error.HTTPError as err:
            if err.code == 404:
                return 404
            last = f"HTTP {err.code}"
        except OSError as err:
            last = err
    raise Fail(f"cannot reach {url} ({last}): retry, or pass --offline to skip the upstream check")


def preflight(host: dict) -> None:
    """Refuse to write with a half-filled config rather than half-provision a workspace."""
    missing = [key for key in ("workspace_id", "runtime_id") if not str(host["multica"].get(key) or "").strip()]
    if missing:
        raise Fail(
            "multica.%s must be set before apply: export %s or fill config/host.json"
            % (", multica.".join(missing),
               " / ".join("MULTICA_" + key.upper() for key in missing)))
    if not str(host["stelow"].get("repo") or "").strip():
        raise Fail("config/host.json: stelow.repo must be set")


def load_groups(path: Path) -> list[dict]:
    doc = read_json(path, "config/columns.json")
    groups = doc.get("groups")
    if not isinstance(groups, list) or not groups:
        raise Fail("config/columns.json has no 'groups'")
    seen_stages: dict[str, str] = {}
    seen_keys: dict[str, str] = {}
    for g in groups:
        gid = g.get("id", "")
        if not KEY_RE.match(gid):
            raise Fail(f"column id {gid!r} is not a valid Multica status key (^[a-z0-9][a-z0-9_]{{0,31}}$)")
        if gid in RESERVED:
            raise Fail(f"column id {gid!r} is a reserved Multica status key")
        if gid in seen_keys:
            raise Fail(f"column id {gid!r} is declared twice")
        seen_keys[gid] = gid
        label = g.get("label") or gid
        slug = re.sub(r"[^a-z0-9]+", "_", label.lower()).strip("_")
        if slug != gid:
            raise Fail(
                f"column {gid!r}: Multica derives the status key from the label, so "
                f"label {label!r} slugifies to {slug!r}. Rename the label or the id so they agree."
            )
        stages = g.get("stages") or []
        if not stages:
            raise Fail(f"column {gid!r} lists no stages")
        if not g.get("agent"):
            # Gates name the reviewer too: it is the handler when the gate runs as
            # an agent, and naming it keeps one mapping instead of two.
            raise Fail(f"column {gid!r} must name an agent (plan, build or review)")
        for stage in stages:
            if stage in seen_stages:
                raise Fail(f"stage {stage!r} is mapped by both {seen_stages[stage]!r} and {gid!r}")
            seen_stages[stage] = gid
    return groups


# ------------------------------------------------------------- stelow stage model


def sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def parse_intents(text: str) -> dict[str, list[str]]:
    """Parse `routes.intents` out of stages.yaml without a YAML dependency."""
    intents: dict[str, list[str]] = {}
    inside = False
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if re.match(r"^\s{2}intents:\s*$", line):
            inside = True
            continue
        if not inside:
            continue
        entry = re.match(r"^\s{4}([A-Za-z0-9_-]+):\s*\[(.*?)\]\s*$", line)
        if entry:
            stages = [s.strip() for s in entry.group(2).split(",") if s.strip()]
            if stages:
                intents[entry.group(1)] = stages
            continue
        if re.match(r"^\s{0,3}\S", line):
            inside = False
    if not intents:
        raise Fail("could not read routes.intents from stages.yaml — the file shape changed")
    return intents


def fetch_upstream(repo: str, ref: str) -> dict[str, str]:
    """Download the tarball once and pull out the files this host reads.

    The catalog and the transitions table are generated upstream from
    stages.yaml. Reading all three keeps the host from guessing the stage ->
    skill ownership or the back-edges it must reproduce.
    """
    url = f"https://codeload.github.com/{repo}/tar.gz/{ref}"
    try:
        with urllib.request.urlopen(url, timeout=90) as resp:  # noqa: S310 (pinned https host)
            blob = resp.read()
    except OSError as exc:
        raise Fail(f"could not download {repo}@{ref}: {exc}")
    members = {"stages": STAGES_MEMBER, "catalog": CATALOG_MEMBER, "transitions": TRANSITIONS_MEMBER}
    out: dict[str, str] = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as archive:
            names = {m.name: m for m in archive.getmembers()}
            for key, member in members.items():
                hit = next((m for n, m in names.items() if n.endswith(member)), None)
                if hit is None:
                    raise Fail(f"{member} is not in {repo}@{ref}")
                handle = archive.extractfile(hit)
                if handle is None:
                    raise Fail(f"{member} is not a regular file in {repo}@{ref}")
                out[key] = handle.read().decode("utf-8")
    except (tarfile.TarError, OSError) as exc:
        raise Fail(f"could not unpack {repo}@{ref}: {exc}")
    return out


def parse_owners(text: str) -> dict[str, str]:
    """stage id -> the skill the catalog dispatches to for that stage."""
    try:
        catalog = json.loads(text)
    except json.JSONDecodeError as exc:
        raise Fail(f"stage-catalog.json is not JSON: {exc}")
    stages = catalog.get("stages") if isinstance(catalog, dict) else None
    if not isinstance(stages, list) or not stages:
        raise Fail("stage-catalog.json has no stages[]")
    owners: dict[str, str] = {}
    for stage in stages:
        if isinstance(stage, dict) and stage.get("id") and stage.get("skill"):
            owners[str(stage["id"])] = str(stage["skill"])
    if not owners:
        raise Fail("stage-catalog.json names no stage owners")
    return owners


def parse_transitions(text: str) -> dict[str, dict[str, list[str]]]:
    """stage -> {next, reject, rework} targets, from the generated mirror.

    A value carries prose after its target list, so each part is cut to its
    leading word; callers drop anything that is not a declared stage.
    """
    edges: dict[str, dict[str, list[str]]] = {}
    stage = None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("### "):
            stage = stripped[4:].strip()
            edges[stage] = {"next": [], "reject": [], "rework": []}
            continue
        if stripped.startswith("## "):
            stage = None
            continue
        if stage is None or ":" not in stripped:
            continue
        key, _, value = stripped.partition(":")
        key = key.strip()
        if key not in ("next", "reject", "rework"):
            continue
        for part in value.split(","):
            word = part.strip().split(" ")[0].split("(")[0].strip()
            cleaned = word.replace("-", "").replace("_", "")
            if not (cleaned and cleaned.isalnum() and word[0].isalpha()):
                break  # the prose tail starts here; nothing after it is a target
            if word in ("none", "blocked", "requires"):
                break
            edges[stage][key].append(word)
    return {k: v for k, v in edges.items() if v["next"] or v["reject"] or v["rework"]}


def ensure_stages(host: dict, force: bool = False) -> dict:
    """Return {intents, owners, rejects, sha, ref} from a pinned stage model."""
    repo = host["stelow"]["repo"]
    ref = host["stelow"]["ref"]
    stages_path = CACHE / "stages.yaml"
    catalog_path = CACHE / "stage-catalog.json"
    transitions_path = CACHE / "transitions.md"
    lock = read_json(LOCK, "stelow.lock.json") if LOCK.exists() else {}
    cached = (
        stages_path.exists()
        and catalog_path.exists()
        and transitions_path.exists()
        and not force
        and lock.get("ref") == ref
        and lock.get("repo") == repo
    )
    if cached:
        stages_text = stages_path.read_text(encoding="utf-8")
        catalog_text = catalog_path.read_text(encoding="utf-8")
        transitions_text = transitions_path.read_text(encoding="utf-8")
        if (
            sha256(stages_text) == lock.get("stages_sha256")
            and sha256(catalog_text) == lock.get("catalog_sha256")
            and sha256(transitions_text) == lock.get("transitions_sha256")
        ):
            return {
                "intents": parse_intents(stages_text),
                "owners": parse_owners(catalog_text),
                "rejects": parse_transitions(transitions_text),
                "sha": lock["stages_sha256"],
                "stages_sha256": lock["stages_sha256"],
                "ref": ref,
            }
    fetched = fetch_upstream(repo, ref)
    stages_text, catalog_text = fetched["stages"], fetched["catalog"]
    transitions_text = fetched["transitions"]
    CACHE.mkdir(exist_ok=True)
    stages_path.write_text(stages_text, encoding="utf-8")
    catalog_path.write_text(catalog_text, encoding="utf-8")
    transitions_path.write_text(transitions_text, encoding="utf-8")
    sha = sha256(stages_text)
    owners = parse_owners(catalog_text)
    rejects = parse_transitions(transitions_text)
    write_json(
        LOCK,
        {
            "repo": repo,
            "ref": ref,
            "stages_sha256": sha,
            "catalog_sha256": sha256(catalog_text),
            "transitions_sha256": sha256(transitions_text),
            # Persisted, not just returned: build_plan derives each column's
            # skills from these owners and doctor checks the back-edges against
            # these rejects. Reading them only in memory left both checks
            # silently empty on the next command.
            "owners": owners,
            "rejects": rejects,
            "fetched_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        },
    )
    return {
        "intents": parse_intents(stages_text),
        "owners": owners,
        "rejects": rejects,
        "sha": sha,
        "stages_sha256": sha,
        "ref": ref,
    }


def stage_universe(groups: list[dict]) -> dict[str, str]:
    return {stage: g["id"] for g in groups for stage in g["stages"]}


def columns_for(intent: str, groups: list[dict], intents: dict[str, list[str]]) -> list[dict]:
    """The columns a given intent actually traverses, in board order."""
    if intent not in intents:
        raise Fail(f"unknown intent {intent!r}; stages.yaml declares: {', '.join(sorted(intents))}")
    route = intents[intent]
    universe = stage_universe(groups)
    missing = [s for s in route if s not in universe]
    if missing:
        raise Fail(
            "stages.yaml declares stages no column maps: "
            + ", ".join(missing)
            + " — add them to config/columns.json"
        )
    wanted = {universe[s] for s in route}
    return [g for g in groups if g["id"] in wanted]


# ------------------------------------------------------------------- multica cli


class Multica:
    """Thin wrapper. Reads are always `--output json`."""

    def __init__(self, host: dict):
        self.bin = host["multica"].get("bin") or "multica"
        self.workspace = host["multica"].get("workspace_id") or ""
        self.calls: list[list[str]] = []

    def argv(self, args: list[str]) -> list[str]:
        cmd = [self.bin] + list(args)
        if self.workspace:
            cmd += ["--workspace-id", self.workspace]
        return cmd

    def run(self, args: list[str], can_fail: bool = False) -> tuple[int, str, str]:
        cmd = self.argv(args)
        self.calls.append(cmd)
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
        except FileNotFoundError:
            raise Fail(f"Multica CLI not found: {self.bin!r} (set MULTICA_BIN or multica.bin in config/host.json)")
        if proc.returncode != 0 and not can_fail:
            detail = (proc.stderr or proc.stdout or "").strip()
            raise Fail(f"FAILED: {' '.join(args)}\n{detail}", code=1)
        return proc.returncode, proc.stdout, proc.stderr

    def json(self, args: list[str]):
        _, out, _ = self.run(list(args) + ["--output", "json"])
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            raise Fail(f"expected JSON from `{' '.join(args)}`, got:\n{out[:400]}")

    # --- live reads -------------------------------------------------------

    @staticmethod
    def _rows(payload, what: str) -> list[dict]:
        """Rows out of a CLI payload, without ever guessing which list is meant.

        Liveness decides create-vs-update in `apply`, so a payload this host
        cannot read must fail loudly: a silent ``[]`` would turn every run into
        a duplicate create.
        """
        if isinstance(payload, list):
            rows = payload
        elif isinstance(payload, dict):
            candidate = [v for v in payload.values() if isinstance(v, list)]
            if len(candidate) > 1:
                raise Fail(f"ambiguous {what}: {len(candidate)} lists in the payload")
            if candidate:
                rows = candidate[0]
            elif "id" in payload:
                return [payload]
            else:
                rows = []
        else:
            raise Fail(f"unexpected payload for {what}: {type(payload).__name__}")
        if not all(isinstance(row, dict) for row in rows):
            raise Fail(f"{what} returned rows that are not objects")
        return rows

    @staticmethod
    def _by_name(rows: list[dict], what: str) -> dict[str, str]:
        out: dict[str, str] = {}
        for row in rows:
            name, ident = row.get("name"), row.get("id")
            if not name or not ident:
                continue
            if name in out:
                raise Fail(f"{what} has two entries named {name!r}: refusing to guess which one")
            out[name] = ident
        return out

    @staticmethod
    def _one(payload, what: str) -> dict:
        """The single object a create or update returns.

        These payloads are richer than list rows — an agent carries its skills,
        env and labels as their own lists — so "the first list of dicts" is the
        wrong rule here and used to fail the run after the skills were imported.
        """
        if isinstance(payload, dict):
            if payload.get("id"):
                return payload
            for key in ("agent", "data", "result", "item"):
                value = payload.get(key)
                if isinstance(value, dict) and value.get("id"):
                    return value
            raise Fail(f"{what}: the payload has no object with an id")
        if isinstance(payload, list) and len(payload) == 1:
            if isinstance(payload[0], dict) and payload[0].get("id"):
                return payload[0]
        raise Fail(f"{what}: expected one object, got {len(payload) if isinstance(payload, list) else type(payload).__name__}")

    def runtimes(self) -> list[dict]:
        return self._rows(self.json(["runtime", "list"]), "runtime list")

    def skills(self) -> dict[str, str]:
        return self._by_name(self._rows(self.json(["skill", "list"]), "skill list"), "skill list")

    def agents(self) -> dict[str, str]:
        return self._by_name(self._rows(self.json(["agent", "list"]), "agent list"), "agent list")

    def agent_skill_ids(self, agent_id: str) -> list[str]:
        payload = self.json(["agent", "skills", "list", agent_id])
        rows = self._rows(payload, "agent skills list")
        out = []
        for row in rows:
            ref = row.get("skill") if isinstance(row.get("skill"), dict) else row
            if isinstance(ref, dict) and ref.get("id"):
                out.append(ref["id"])
        return out

    def workflows(self) -> dict[str, str]:
        return self._by_name(self._rows(self.json(["workflow", "list"]), "workflow list"), "workflow list")

    def workflow(self, name: str) -> dict | None:
        code, out, _ = self.run(["workflow", "get", name], can_fail=True)
        if code != 0:
            return None
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            raise Fail(f"expected JSON from `workflow get {name}`, got:\n{out[:400]}")

    def project_workflow(self, project_id: str):
        code, out, _ = self.run(["project", "workflow", "get", project_id], can_fail=True)
        if code != 0:
            return None
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            return None


# Bound once, at import time, so a test double that replaces Multica cannot remove it.
rows_of = Multica._rows


# ------------------------------------------------------------------- the plan


def agent_name(host: dict, agent: str) -> str:
    prefix = host["agents"].get("name_prefix") or "stelow"
    return f"{prefix}-{agent}"


def workflow_name(host: dict, intent: str, gates: str) -> str:
    """The declared id of the chain workflow.

    Every variant used to get its own name (`stelow-feature-human`), which was fine
    while one graph held every shape and became the bug the moment explore and
    research split off: the chain is one workflow per repository, and what varies
    with the intent is its columns, not its name.
    """
    return str(load_install()["workflows"][0]["id"])


def section_map(path: Path) -> dict[str, str]:
    """Split stages/columns.md into {column id: instruction text}."""
    text = path.read_text(encoding="utf-8")
    out: dict[str, list[str]] = {}
    current = None
    for line in text.splitlines():
        heading = re.match(r"^##\s+([a-z0-9_]+)\s*$", line)
        if heading:
            current = heading.group(1)
            out[current] = []
            continue
        if line.startswith("# ") or line.startswith("## "):
            current = None
            continue
        if current:
            out[current].append(line)
    return {k: "\n".join(v).strip() for k, v in out.items()}


def load_install() -> dict:
    path = ROOT / "config" / "install.json"
    if not path.is_file():
        raise Fail("config/install.json is missing")
    return json.loads(path.read_text())


def skills_block(skills: list[str]) -> str:
    """The skills a step runs, named inside the step that runs them.

    The chain's steps described their work for six hundred characters and never
    named the skill carrying the method, so the agent either searched for it or
    improvised. Named skills come from the declaration (stages.yaml, via
    data/stage-skills.json), so this cannot drift the way a hand-written sentence
    does.
    """
    if not skills:
        return ""
    return "\n\n## Skills this step runs\n\n" + "\n".join(f"- `{skill}`" for skill in skills)


def menu_block(board: dict) -> str:
    """The menu, in the step that is told to choose from it.

    A step that says "pick from the menu" and does not carry the menu leaves the
    runner to guess or to search the filesystem for it. Both worked; neither is
    what the rule says, and only one of them survives a runner that does not think
    to look.
    """
    lines = ["## The menu", "", "Exactly one of these. Anything else is off-menu.", ""]
    for item in board["menu"]:
        lines.append(f"- `{item['skill']}` — {item['when']}")
    return "\n".join(lines)


class IdMap(dict):
    """Stands in for an id it has not seen, so a check can compare steps on a
    workspace where that agent does not exist yet."""

    def __missing__(self, key):
        return str(key)


def install_plans(host: dict, args, groups: list[dict], lock: dict) -> list[dict]:
    """One plan per workflow the declaration names.

    A tracker binds one workflow to a container, and a container is usually a
    repository, so three shapes cannot be three flows inside one project. The chain
    gets a project per repository because it is the flow that edits code; explore
    and research are questions *about* repositories, so each owns one shared
    project and the card names the repository it is about.
    """
    plans: list[dict] = []
    for workflow in load_install()["workflows"]:
        if workflow["kind"] == "chain":
            plan = build_plan(
                host, groups, lock["intents"], workflow.get("intent") or getattr(args, "intent", None) or "feature",
                getattr(args, "gates", None) or "human", "",
            )
            plan["workflow"] = workflow["id"]
            # `apply --project X` binds one repository; `install` binds them all.
            plan["project"] = getattr(args, "project", None) or ""
        else:
            board = load_board(workflow["board"])
            problems = board_problems(board)
            if problems:
                raise Fail(f"{workflow['board']} board would not survive a real card: " + "; ".join(problems))
            plan = board_plan(host, board)
            plan["workflow"] = workflow["id"]
            plan["project"] = workflow.get("project") or board.get("project") or ""
        plan["_workflow"] = workflow
        plans.append(plan)
    return plans


def resolve_plans(host: dict, args, groups, lock) -> list[dict]:
    """Which workflows a command line means, in declaration order.

    `apply` and `verify` used to assume a single workflow, which is why the three
    shapes had to be crammed into one graph. Naming them is the whole point, so the
    default is the one a bare command means (the chain) and `--all-workflows`
    (or `install`) is every one of them.
    """
    if getattr(args, "board", None):
        return [resolve_plan(host, args, groups, lock)]
    plans = install_plans(host, args, groups, lock)
    wanted = getattr(args, "workflow_name", None) or getattr(args, "workflow", None)
    if wanted:
        named = [plan for plan in plans if plan["workflow"] == wanted]
        if not named:
            raise Fail(f"no workflow {wanted!r}; declared: " + ", ".join(plan["workflow"] for plan in plans))
        return named
    if getattr(args, "install", False) or getattr(args, "all_workflows", False):
        return plans
    return plans[:1]


def track_entry(track_id: str) -> str:
    for track in load_install()["tracks"]:
        if track["id"] == track_id:
            entry = str(track["entry"])
            return entry if track["kind"] == "chain" else entry.replace("-", "_")
    raise Fail(f"no track called {track_id}; tracks are: " + ", ".join(t["id"] for t in load_install()["tracks"]))


def loose_gate_ids() -> set[str]:
    gates = set()
    for track in load_install()["tracks"]:
        if track["kind"] != "loose":
            continue
        board = load_board(track["board"])
        for column in board["columns"]:
            if column.get("gate"):
                gates.add(f"{track['board']}-{column['id']}")
    return gates


def build_plan(host: dict, groups: list[dict], intents: dict[str, list[str]], intent: str, gates: str, project: str) -> dict:
    columns = columns_for(intent, groups, intents)
    live_keys = {col["id"] for col in columns}
    for index, col in enumerate(columns):
        back = col.get("back_to") or ""
        if back and back not in live_keys:
            # A shorter intent chain can omit the column stelow reworks to.
            # Clamp to the preceding column instead of emitting a dangling status.
            col["back_to"] = columns[index - 1]["id"] if index else ""
    instructions = section_map(ROOT / "stages" / "columns.md")
    owners = {}
    try:
        owners = read_json(LOCK, "stelow.lock.json").get("owners") or {}
    except Fail:
        owners = {}

    for col in columns:
        if not instructions.get(col["id"]):
            raise Fail(f"stages/columns.md has no ## {col['id']} section — every column needs instructions")

    def column_skills(col: dict) -> list[str]:
        """The catalog owner of each stage, then the supporting skills."""
        derived = [owners.get(stage) for stage in col["stages"] if owners.get(stage)]
        return list(dict.fromkeys(derived + list(col.get("skills") or [])))

    skills: list[str] = []
    for col in columns:
        for skill in column_skills(col):
            if skill not in skills:
                skills.append(skill)
    agents: list[dict] = []
    by_name: dict[str, dict] = {}
    for col in columns:
        if col.get("gate") and gates != "agent":
            # A person handles the gate, so no agent needs to load its skill.
            continue
        name = col["agent"]
        if name not in by_name:
            by_name[name] = {"agent": name, "skills": []}
            agents.append(by_name[name])
        for skill in column_skills(col):
            # Two columns may share one agent (fewer, broader agents add tokens
            # nowhere and dilute attention less); the agent needs the union, or
            # the stages it handles lose their owner and dispatch unguarded.
            if skill not in by_name[name]["skills"]:
                by_name[name]["skills"].append(skill)
    return {
        "intent": intent,
        "gates": gates,
        "project": project,
        "columns": [{"id": c["id"], "label": c.get("label", c["id"]), "category": c.get("category", "started"),
                     "stages": c["stages"], "gate": bool(c.get("gate")), "agent": c.get("agent"),
                     "back_to": c.get("back_to"), "instructions": instructions[c["id"]],
                     "skills": column_skills(c)} for c in columns],
        "skills": skills,
        "agents": agents,
        "workflow": workflow_name(host, intent, gates),
    }


def build_steps(plan: dict, host: dict, agent_ids: dict[str, str], create: bool) -> list[dict]:
    columns = plan["columns"]
    steps: list[dict] = [{"status_key": "todo", "next_status_key": columns[0]["id"] if columns else "done"}]
    for index, col in enumerate(columns):
        # A track that is not the chain names its own successor: the last explore
        # column must not fall into the first research column just because it is
        # next in the list.
        nxt = col.get("next") or (columns[index + 1]["id"] if index + 1 < len(columns) else "done")
        step: dict = {}
        if create:
            step["new_status"] = {"name": col["label"], "category": col["category"]}
        else:
            step["status_key"] = col["id"]
        if col["gate"]:
            if plan["gates"] == "human":
                step["handler"] = {"type": "project_lead"}
            else:
                step["handler"] = {"type": "agent", "id": agent_ids[agent_name(host, col["agent"])]}
        else:
            step["handler"] = {"type": "agent", "id": agent_ids[agent_name(host, col["agent"])]}
        step["instructions"] = col["instructions"] + skills_block(col.get("skills") or [])
        step["next_status_key"] = nxt
        if col.get("back_to"):
            step["back_status_key"] = col["back_to"]
        steps.append(step)
    steps.append({"status_key": "done"})
    return steps


# ------------------------------------------------------------------- rendering


def render_plan(plan: dict, host: dict, lock: dict, live_agents: dict[str, str], live_skills: dict[str, str], live_wf: dict[str, str]) -> str:
    lines = [
        f"stelow   repo={host['stelow']['repo']}  ref={lock.get('ref')}  stages.sha256={str(lock.get('sha'))[:12]}",
        f"intent   {plan['intent']}   gates={plan['gates']}   project={plan['project'] or '(none)'}",
        "",
        f"skills   {len(plan['skills'])} required "
        f"({sum(1 for s in plan['skills'] if s in live_skills)} already present)",
    ]
    for skill in plan["skills"]:
        lines.append(f"  {'=' if skill in live_skills else '+'} {skill}")
    lines.append("")
    lines.append(f"agents   {len(plan['agents'])} ({sum(1 for a in plan['agents'] if agent_name(host, a['agent']) in live_agents)} already present)")
    for agent in plan["agents"]:
        name = agent_name(host, agent["agent"])
        lines.append(f"  {'=' if name in live_agents else '+'} {name}  [{len(agent['skills'])} skills]")
    lines.append("")
    exists = plan["workflow"] in live_wf
    lines.append(f"workflow {plan['workflow']}  ({'update' if exists else 'create'})")
    chain = [("todo", None)] + [(col["id"], col) for col in plan["columns"]] + [("done", None)]
    for index, (key, col) in enumerate(chain):
        if col is None:
            lines.append(f"  {key:<16} —")
            continue
        handler = "project_lead" if col["gate"] and plan["gates"] == "human" else agent_name(host, col["agent"])
        gate = " · gate" if col["gate"] else ""
        nxt = chain[index + 1][0] if index + 1 < len(chain) else ""
        back = f"  back → {col['back_to']}" if col.get("back_to") else ""
        stages = " ".join(col["stages"])
        lines.append(f"  {key:<16} {handler:<22}{gate:<6} → {nxt:<16}{back}")
        lines.append(f"  {'':<16} stages: {stages}")
    if plan["project"]:
        lines.append("")
        lines.append(f"project  {plan['project']} → {plan['workflow']}")
    return "\n".join(lines)


# -------------------------------------------------------------------- commands


def cmd_sync(host: dict, args) -> int:
    lock = ensure_stages(host, force=True)
    say(f"pinned {host['stelow']['repo']}@{lock['ref']}  stages.sha256={lock['sha'][:12]}")
    for intent, stages in sorted(lock["intents"].items()):
        say(f"  {intent:<14} {len(stages):>2} stages: {' '.join(stages)}")
    return 0


def resolve_plan(host: dict, args, groups, lock) -> dict:
    """The plan `plan` and `apply` share, whichever shape was asked for.

    Both used to build it themselves, and the board flag was wired into one of
    them: `apply --board` silently applied the chain instead. One resolver, so a
    shape added later cannot be honoured by half the commands.
    """
    if getattr(args, "install", False):
        return install_plans(host, args, groups, lock)[0]
    board_spec = getattr(args, "board", None)
    if not board_spec:
        return build_plan(host, groups, lock["intents"], args.intent, args.gates, args.project)
    board = load_board(board_spec)
    problems = board_problems(board)
    if problems:
        raise Fail("board is not runnable: " + "; ".join(problems))
    return board_plan(host, board)


def render_board_plan(plan: dict) -> str:
    """A board plan is a shape of columns and one menu, so render it as that."""
    lines = [f"{plan['workflow']}  → project {plan['project']!r}  gates={plan['gates']}",
             f"skills imported: {len(plan['skills'])}  runner: {plan['agents'][0]['agent']}"]
    for column in plan["columns"]:
        who = "a person" if column.get("gate") else plan["agents"][0]["agent"]
        back = f"  back to {column['back_to']}" if column.get("back_to") else ""
        lines.append(f"  {column['id']:<8} {column['label']:<10} {who}{back}")
    return "\n".join(lines)


def cmd_plan(host: dict, args, groups, lock) -> int:
    plans = resolve_plans(host, args, groups, lock)
    if len(plans) > 1:
        multica = Multica(host)
        try:
            live_skills = multica.skills()
            live_agents = multica.agents()
            live_wf = multica.workflows()
        except Fail as exc:
            say(f"note: live state unavailable ({exc})")
            live_skills, live_agents, live_wf = {}, {}, {}
        for index, entry in enumerate(plans):
            if index:
                say("")
            say(f"--- {entry['workflow']}")
            say(render_board_plan(entry) if entry.get("_board")
                else render_plan(entry, host, lock, live_agents, live_skills, live_wf))
        say("")
        say("no writes performed. run `apply` to converge.")
        return 0
    plan = plans[0]
    if plan.get("_board"):
        say(json.dumps(plan, indent=2) if getattr(args, "json", False) else render_board_plan(plan))
        return 0
    if args.json:
        say(json.dumps(plan, indent=2))
        return 0
    multica = Multica(host)
    try:
        live_skills = multica.skills()
        live_agents = multica.agents()
        live_wf = multica.workflows()
    except Fail as exc:
        say(f"note: live state unavailable ({exc})")
        live_skills, live_agents, live_wf = {}, {}, {}
    say(render_plan(plan, host, lock, live_agents, live_skills, live_wf))
    say("")
    say("no writes performed. run `apply` to converge.")
    return 0


def owner_gaps(plan: dict, owners: dict[str, str]) -> list[str]:
    """Stages in the plan whose catalog entry names no skill.

    A column's skills are derived from these owners, so a stage without one is a
    stage whose instructions no agent loads — it would run on the column text
    alone.
    """
    gaps: list[str] = []
    for col in plan["columns"]:
        for stage in col["stages"]:
            if not owners.get(stage):
                gaps.append(f"{col['id']}: stage {stage} has no owner in the stage catalog")
    return gaps


def flow_gaps(plan: dict, edges: dict[str, dict[str, list[str]]], universe: dict[str, str]) -> list[str]:
    """The board's back-edges must be the ones stelow declares.

    A gate that rejects sends the run back to a named stage. If the column that
    receives it does not hold that stage, the rework lands on a handler the
    methodology did not expect, and the loop the workflow promises silently
    becomes a forward move. A non-gate column's back edge is checked against the
    stage's rework/reject targets rather than assumed.
    """
    gaps: list[str] = []
    order = {col["id"]: index for index, col in enumerate(plan["columns"])}
    for col in plan["columns"]:
        back = col.get("back_to") or ""
        declared: dict[str, list[str]] = {}
        for stage in col["stages"]:
            stage_edges = edges.get(stage) or {}
            for target in stage_edges.get("next", []):
                where = universe.get(target)
                if where is None:
                    gaps.append(f"{stage}: stelow advances to unknown stage {target!r}")
                elif where in order and order[where] < order.get(col["id"], 0):
                    gaps.append(f"{stage}: stelow advances to {target} in the earlier column {where}")
            for field in ("reject", "rework"):
                for target in stage_edges.get(field, []):
                    where = universe.get(target)
                    if where is None:
                        gaps.append(f"{stage}: stelow sends work back to unknown stage {target!r}")
                    else:
                        declared.setdefault(where, []).append(f"{target} ({field} of {stage})")
        if col["gate"] and declared:
            for where, why in declared.items():
                if back != where:
                    gaps.append(
                        f"{col['id']}: {', '.join(why)} lives in column {where},"
                        f" but back_to is {back!r}"
                    )
        elif back and declared and back not in declared:
            gaps.append(
                f"{col['id']}: back_to is {back!r}, but stelow sends this column back to "
                + ", ".join(sorted(declared))
            )
    return gaps


def artifact_report(present, groups, aliases=None):
    """Which declared artifacts a card is missing.

    `present` is the set of filenames attached anywhere on the card. Pure, so the
    answer can be tested without a workspace: a card is only reproducible from
    itself if every stage left its files behind, and this is how a host finds out
    that one did not.

    `aliases` maps a declared name to the names it was attached under before the
    naming rule existed. A card that ran across the change is not broken, and
    calling it broken is how a report stops being read: the hit is reported as
    legacy instead of as a gap.
    """
    aliases = aliases or {}
    declared, missing, legacy = [], [], []
    for group in groups:
        for name in group.get("artifacts") or []:
            declared.append(name)
            if name in present:
                continue
            older = [alias for alias in aliases.get(name) or [] if alias in present]
            if older:
                legacy.append((name, older[0]))
            else:
                missing.append((group["id"], name))
    return declared, missing, legacy


def load_board(spec: str):
    """Load a board by name (`research`) or by path (`boards/research.json`)."""
    candidate = ROOT / "boards" / (spec if spec.endswith(".json") else spec + ".json")
    path = candidate if candidate.is_file() else Path(spec)
    if not path.is_file():
        raise Fail(f"no board called {spec}: expected {candidate} or a path to a json file")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise Fail(f"{path} is not valid json: {exc}") from exc


def board_problems(board: dict) -> list[str]:
    """What is wrong with a board declaration, in the order a person would ask.

    A board is the loose counterpart of the chain: one card, one skill, one
    artifact. These rules are the whole reason it can be short, so each one is a
    failure the board would otherwise produce silently on a real card.
    """
    problems = []
    for field in ("workflow", "project", "runner", "skill_prefix", "menu", "columns"):
        if not board.get(field):
            problems.append(f"missing {field}")
    if problems:
        return problems

    if not str(board["workflow"]).startswith("stelow-"):
        problems.append("workflow must start with 'stelow-' so it is obvious what owns it")
    if not (ROOT / "agents" / f"{board['runner']}.md").is_file():
        problems.append(f"no agents/{board['runner']}.md: an agent with no instructions is an empty prompt")

    seen = set()
    for column in board["columns"]:
        if column.get("id") in seen:
            problems.append(f"column {column.get('id')} declared twice")
        seen.add(column.get("id"))
        if not str(column.get("instructions") or "").strip():
            problems.append(f"column {column.get('id')} has no instructions")
        if column.get("category") not in {"unstarted", "started"}:
            problems.append(f"column {column.get('id')} has category {column.get('category')!r}")
        if column.get("gate") and not column.get("instructions"):
            problems.append(f"gate column {column.get('id')} says nothing about what a person decides")

    runners = [c for c in board["columns"] if not c.get("gate")]
    if len(runners) != 1:
        problems.append(f"exactly one working column expected, found {len(runners)}")
    elif runners[0].get("agent") != board["runner"]:
        problems.append(f"the working column must be run by {board['runner']}, not {runners[0].get('agent')}")

    for column in board["columns"]:
        back = column.get("back_to")
        if back and back not in seen:
            problems.append(f"column {column.get('id')} backs to {back}, which does not exist")

    menu = board["menu"]
    for entry in menu:
        skill = str(entry.get("skill") or "")
        if not skill.startswith(str(board["skill_prefix"])):
            problems.append(f"menu entry {skill!r} is not a {board['skill_prefix']} skill")
        if not str(entry.get("when") or "").strip():
            problems.append(f"menu entry {skill!r} has no 'when': a menu without reasons is a guess")
    if len({entry.get("skill") for entry in menu}) != len(menu):
        problems.append("menu lists the same skill twice")
    return problems


def board_plan(host: dict, board: dict) -> dict:
    """A board as the plan shape `build_steps` already knows how to push."""
    skills = [entry["skill"] for entry in board["menu"]]
    return {
        "workflow": board["workflow"],
        "intent": board["board"],
        "gates": board.get("gates") or "human",
        "project": board["project"],
        # The working column carries the menu. Without it the runner was told to
        # "load exactly one skill from the menu" and given no menu: it only worked
        # while the card happened to name its strategy.
        "columns": [dict(column) if column.get("gate") else
                    dict(column, instructions=column["instructions"] + "\n\n" + menu_block(board))
                    for column in board["columns"]],
        "agents": [{"agent": board["runner"], "skills": skills}],
        "skills": skills,
        "_board": True,
    }


def cmd_board(host: dict, args) -> int:
    specs = getattr(args, "names", None) or []
    if not specs:
        specs = sorted(p.stem for p in (ROOT / "boards").glob("*.json"))
    bad = 0
    for spec in specs:
        board = load_board(spec)
        problems = board_problems(board)
        issue = board.get("board") or spec
        if problems:
            bad += 1
            say(f"{issue}: {len(problems)} problem(s)")
            for problem in problems:
                say(f"  - {problem}")
            continue
        menu = len(board["menu"])
        say(f"{issue}: {board['workflow']} → project {board['project']!r}, {len(board['columns'])} columns, "
            f"{menu} skills, one per card")
        for column in board["columns"]:
            who = "a person" if column.get("gate") else board["runner"]
            back = f", back to {column['back_to']}" if column.get("back_to") else ""
            say(f"  {column['id']:<8} {column['label']:<10} {who}{back}")
    if bad:
        raise Fail(f"{bad} board(s) would not survive a real card")
    return 0


def load_policy() -> dict:
    try:
        return json.loads((ROOT / "config" / "columns.json").read_text()).get("policy") or {}
    except (OSError, json.JSONDecodeError):
        return {}


def load_aliases() -> dict:
    try:
        return json.loads((ROOT / "config" / "columns.json").read_text()).get("artifact_aliases") or {}
    except (OSError, json.JSONDecodeError):
        return {}


def active_stamps(runs: list[dict]) -> tuple[str, str]:
    """The oldest started stamp and the oldest queued stamp among the active runs.

    Blanks are dropped rather than compared: a run that is still queued has no
    `started_at`, so `min()` over the raw values returned "" and a run that had
    been going for an hour hid behind it.
    """
    started = [stamp for stamp in (str(run.get("started_at") or "") for run in runs) if stamp]
    queued = [stamp for stamp in
              (str(run.get("created_at") or "") for run in runs
               if str(run.get("status") or "") == "queued") if stamp]
    return (min(started) if started else ""), (min(queued) if queued else "")


def zombie_runs(issues, active_start, minutes, now=None):
    """Cards whose active run has been "running" longer than `minutes`.

    A tracker reports a run as running until something ends it, so a run whose
    process died looks exactly like a slow one: the card sits in an agent column,
    holds a run, has no comment and no marker, and every other check calls it
    healthy. One did, for half an hour, on a canary card — the same shape as the
    card that waited seventeen minutes in a gate with nothing marking it.
    """
    now = now or datetime.now(timezone.utc)
    keys = {str(issue.get("id")): str(issue.get("key") or issue.get("id")) for issue in issues}
    stale = []
    for issue_id, started in active_start.items():
        if not started:
            continue
        try:
            began = datetime.fromisoformat(str(started).replace("Z", "+00:00"))
        except ValueError:
            continue
        age = (now - began).total_seconds() / 60.0
        if age > minutes:
            stale.append((keys.get(issue_id, str(issue_id)), round(age, 1)))
    return sorted(stale, key=lambda row: -row[1])


def stalled_cards(issues, known, hours, now=None):
    """Cards that have not moved in `hours`.

    Pure: `now` is passed in so the test does not depend on the clock. The board
    check catches a card that is *invisible*; this catches a card that is visible
    and idle, which is the other way a workflow quietly stops delivering.
    """
    now = now or datetime.now(timezone.utc)
    stalled = []
    for issue in issues:
        status = str(issue.get("status") or "")
        if status not in known or status in TERMINAL_STATUSES:
            continue
        stamp = issue.get("updated_at") or issue.get("created_at")
        if not stamp:
            continue
        try:
            touched = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
        except ValueError:
            continue
        if touched.tzinfo is None:
            touched = touched.replace(tzinfo=timezone.utc)
        idle = (now - touched).total_seconds() / 3600
        if idle > hours:
            stalled.append((issue.get("key") or str(issue.get("id")), status, round(idle, 1)))
    return stalled


def back_edge_findings(events, groups, limit):
    """Cards that spent their back-edge budget.

    Pure: `events` is one card's timeline, `groups` the columns. A budget belongs
    to a pair — a column and the `back_to` it can send a card to — and every
    status change along that pair spends one round.

    The reason this is a check and not advice: two rounds of audit is a reviewer
    working, a fourth is the loop deciding by attrition, and nothing in a prompt
    can notice the difference from inside one run.
    """
    pairs = {(str(group["id"]), str(group["back_to"])) for group in groups if group.get("back_to")}
    counts: dict[tuple[str, str], int] = {}
    for event in events:
        if str(event.get("action") or "") != "status_changed":
            continue
        details = event.get("details") or {}
        pair = (str(details.get("from") or ""), str(details.get("to") or ""))
        if pair in pairs:
            counts[pair] = counts.get(pair, 0) + 1
    return [(src, dst, n) for (src, dst), n in sorted(counts.items()) if n > limit]


HUMAN_GATE_MARKER = "needs-human"

# A closed card has no run and no marker and that is correct. Without this the
# orphan check fires on every card that ever finished, which is how the first
# timer run reported two closed cards as abandoned.
TERMINAL_STATUSES = {"done", "cancelled"}
STALL_NUDGE = (
    "The previous run ended without moving this card. Read the card, do the stage, then finish one of two "
    "ways: move it forward with its artifact, or mark it needs-human and say in one line who owes what. "
    "Do not start over, and do not repeat work the artefacts already record."
)

WAITING_NUDGE = (
    "This card is parked for a human ruling. Check for an answer; if there is "
    "none, say in one line who owes what and re-arm instead of waiting silently."
)


def gate_ids(groups) -> set[str]:
    return {str(group["id"]) for group in groups if group.get("gate")}


def human_owner(issue: dict, host: dict) -> str:
    """The member a parked card belongs to: whoever opened it, else the configured one.

    The label says what is happening; the assignee says who owes the answer. A card
    with the first and not the second is a card nobody is looking at — which is what
    CAL-57 did at the diff gate: no marker and an owner that was still the agent
    that wrote the code.
    """
    if str(issue.get("creator_type") or "") == "member" and issue.get("creator_id"):
        return str(issue["creator_id"])
    return str((host.get("human") or {}).get("member_id") or "")


def assign_owner(live, issue: dict, host: dict) -> bool:
    """Point the card at the person who owes the answer, if it is not already there."""
    owner = human_owner(issue, host)
    issue_id = str(issue.get("id") or "")
    if not owner or not issue_id or str(issue.get("assignee_id") or "") == owner:
        return False
    return live.run(["issue", "update", issue_id, "--assignee-id", owner], can_fail=True) == 0


def board_findings(issues, gates, known, running, labels):
    """Cards that are waiting invisibly.

    Pure, so it is testable without a workspace: `running` is the set of issue
    ids with an active run and `labels` maps an issue id to its label names.

    Four states exist and three of them are invisible on the board:

    - a card in a gate column with no run and no marker is waiting on a person
      and looks exactly like a run that died. This is how CAL-52 sat in
      `diff_gate` with nothing on it saying who owed what;
    - a card in an agent column with no run and no marker is an orphan: its run
      ended and nothing will pick it up;
    - a marker on a card whose run is active is stale;
    - a marker with no run in a gate column is the healthy waiting state, but only
      when a person owns it: the label says what is happening and the assignee says
      who owes the answer.
    """
    unmarked, unassigned, orphans, stale = [], [], [], []
    for issue in issues:
        issue_id = str(issue.get("id") or "")
        status = str(issue.get("status") or "")
        if not issue_id or status not in known or status in TERMINAL_STATUSES:
            continue
        key = issue.get("key") or issue_id
        marked = HUMAN_GATE_MARKER in (labels.get(issue_id) or set())
        active = issue_id in running
        if status in gates:
            if not active and not marked:
                unmarked.append(key)
            if not active and str(issue.get("assignee_type") or "") != "member":
                unassigned.append(key)
            if active and marked:
                stale.append(key)
        elif not active and not marked:
            orphans.append(key)
        elif active and marked:
            stale.append(key)
    return unmarked, unassigned, orphans, stale


def lane_for_card(issue: dict, status: str, project_titles: dict[str, str]) -> dict | None:
    """Which lane this card belongs to, if any.

    Both lanes use the same status keys (`bucket`, `doing`, `review`), so the status
    alone cannot say which one a card is on: asked live, a research card answered
    "lane: explore" because explore sorts first. The strategy the card names decides,
    then its project, then a status that only one lane uses.

    A card in a lane owes one artifact, not the chain's eighteen. Without this,
    `card` told an Explore card it owed 01-spec-product.md through
    18-audit-table.md, which is true of no card on that board.
    """
    boards = [load_board(path.stem) for path in sorted((ROOT / "boards").glob("*.json"))]
    strategy = declared_strategy(issue)
    for board in boards:
        if board.get("skill_prefix") and strategy.startswith(str(board["skill_prefix"])):
            return board
    project = str(issue.get("project_id") or issue.get("project") or "")
    title = project_titles.get(project, "")
    for board in boards:
        if title and title == board.get("project"):
            return board
    lanes = [board for board in boards if status in {column["id"] for column in board["columns"]}]
    return lanes[0] if len(lanes) == 1 else None


def declared_strategy(issue: dict) -> str:
    """The skill a card names, from the line `ask` writes.

    It wins over the runner's own choice, so `card` reports what was asked for
    instead of guessing which entry of the menu the run used.
    """
    found = re.search(r"\*\*Strategy:\*\*\s*([A-Za-z0-9-]+)", str(issue.get("description") or ""))
    return found.group(1) if found else ""


def cmd_park(host: dict, args) -> int:
    """Mark a card as waiting on a person, and put it in front of that person.

    One command instead of three, because the three drifted apart in practice: the
    label was added, the wakeup was armed, and the assignee stayed on the agent that
    asked the question.
    """
    live = Multica(host)
    issue = Multica._one(live.json(["issue", "get", args.issue]), "issue get")
    key = str(issue.get("key") or issue.get("id") or args.issue)
    issue_id = str(issue.get("id") or args.issue)
    live.run(["issue", "label", "add", issue_id, HUMAN_GATE_MARKER], can_fail=True)
    assign_owner(live, issue, host)
    if args.why:
        live.run(["issue", "comment", "add", issue_id, "--content", args.why], can_fail=True)
    if args.wake:
        live.run(["issue", "wakeup", "create", issue_id, "--after", args.wake,
                  "--instruction", WAITING_NUDGE], can_fail=True)
    owner = human_owner(issue, host)
    say(f"{key}  parked for {owner or 'nobody (set human.member_id in config/host.json)'}"
        + (f", re-armed in {args.wake}" if args.wake else ""))
    return 0 if owner else 1


def cmd_card(host: dict, args, groups) -> int:
    """What a card kept, and where it stopped."""
    live = Multica(host)
    issue = Multica._one(live.json(["issue", "get", args.issue]), "issue get")
    issue_id = str(issue.get("id") or args.issue)
    status = str(issue.get("status") or "?")
    present = set()
    for comment in rows_of(live.json(["issue", "comment", "list", issue_id]), "issue comment list"):
        for attachment in comment.get("attachments") or []:
            name = str(attachment.get("filename") or "")
            if name:
                present.add(name)
    try:
        titles = {str(row.get("id")): str(row.get("title")) for row in rows_of(live.json(["project", "list"]), "project list")}
    except (Fail, KeyError):
        titles = {}
    board = lane_for_card(issue, status, titles)
    lanes = [lane for lane in (load_board(path.stem) for path in sorted((ROOT / "boards").glob("*.json")))
             if status in {column["id"] for column in lane["columns"]}]
    if not board and lanes:
        say(f"{issue.get('key') or issue_id}  status: {status}  lane: ambiguous")
        say(f"lanes sharing this status: {', '.join(lane['board'] for lane in lanes)}")
        say("the card names no strategy and sits in no lane project, so nothing here can say which menu judges it")
        return 1
    if board:
        say(f"{issue.get('key') or issue_id}  status: {status}  lane: {board['board']}")
        strategy = declared_strategy(issue)
        if strategy:
            say(f"strategy: {strategy}")
        else:
            say(f"strategy: none declared, so the runner names its choice in one line")
        say(f"owes: one artifact from {len(board['menu'])} skills; kept {len(present)}")
        for name in sorted(present):
            say(f"  kept     {name}")
        owed = not present and status in {"review", "done"}
        if owed:
            say(f"FAIL: the card reached {status!r} with no artifact attached")
        return 1 if owed else 0
    aliases = load_aliases()
    declared, missing, legacy = artifact_report(present, groups, aliases)
    kept = len(declared) - len(missing)
    say(f"{issue.get('key') or issue_id}  status: {status}")
    say(f"declared: {len(declared)}   present: {kept}   missing: {len(missing)}")
    for name, older in legacy:
        say(f"  legacy   {older}  stands in for {name}")
    for group_id, name in missing:
        say(f"  missing  {name}  ({group_id})")
    if status != "done":
        say(f"note: the card is not closed (status {status!r}), so missing files may still be owed")
    return 1 if missing and status == "done" else 0


def cmd_doctor(host: dict, args, groups, lock) -> int:
    offline = getattr(args, "offline", False)
    checks: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: str = "") -> None:
        checks.append((name, bool(ok), detail))

    # 1. the tool's own runtime
    check("python >= 3.9", sys.version_info >= (3, 9), "%d.%d.%d" % sys.version_info[:3])

    # 2. the CLI it drives
    binary = host["multica"].get("bin") or "multica"
    found = shutil.which(binary)
    check("multica on PATH", bool(found), found or f"{binary} not found")

    # 3. config the writes depend on
    check("workspace_id", bool(host["multica"].get("workspace_id")), "set in config/host.json")
    check("runtime_id", bool(host["multica"].get("runtime_id")), "agents cannot start without it")

    # 4. the stage model is pinned, and names the stages the host maps
    check("stages.yaml pinned", bool(lock.get("sha")), str(lock.get("sha"))[:12])
    owners = lock.get("owners") or {}
    check("stage owners read", bool(owners), f"{len(owners)} stages")

    # 5. skill ownership lines up with the columns
    plans = install_plans(host, args, groups, lock)
    plan = plans[0]
    all_skills = list(dict.fromkeys(skill for entry in plans for skill in entry["skills"]))
    gaps = owner_gaps(plan, owners)
    check("every planned stage has an owner", not gaps, "; ".join(gaps[:3]))

    # 6. the back-edges reproduce the transitions table
    flows = flow_gaps(plan, lock.get("rejects") or {}, stage_universe(groups))
    check("gate back-edges match transitions", not flows, "; ".join(flows[:3]))

    # 6. every planned skill is at the pinned upstream path
    if not offline:
        missing = missing_upstream(host, all_skills)
        check(
            "every planned skill is importable",
            not missing,
            f"{len(missing)} of {len(all_skills)} not found: " + ", ".join(missing[:4]),
        )

    # 7. the runtime the agents are bound to is actually online
    if found and not offline:
        runtime_ok, runtime_detail = runtime_check(host, Multica(host))
        check("runtime is online", runtime_ok, runtime_detail)

    # 8. the live workspace answers, if the CLI is usable
    if found and not offline:
        multica = Multica(host)
        try:
            live = multica.skills()
            check("CLI authorized", True, f"{len(live)} skills visible")
            missing = [s for s in all_skills if s not in live]
            check("planned skills installed", not missing, ", ".join(missing[:4]))
        except Fail as exc:
            check("CLI authorized", False, str(exc).splitlines()[0][:120])
    # 9. nothing on the board is waiting invisibly
    if found and not offline and host["multica"].get("project_id"):
        live = Multica(host)
        try:
            issues = rows_of(live.json(["issue", "list"]), "issue list")
        except Fail as exc:
            check("board readable", False, str(exc).splitlines()[0][:120])
            issues = None
        if issues is not None:
            running, labels, spent, active_start, queued_since = set(), {}, {}, {}, {}
            limit = int(load_policy().get("max_back_edges", 2))
            # `todo` is the entry status every workflow starts from and it has no
            # handler, so a card left there does nothing at all. It is not a group
            # in columns.json, which is why the first version of this check could
            # not see the card that sat in it for eight minutes.
            known = {str(group["id"]) for group in groups} | {"todo", "done", "cancelled"}
            # Lane status keys come from the board declaration. Asking the old
            # prefixing helper answered `explore_bucket` while the live workflow uses
            # `bucket`, so every lane card was invisible to this check.
            for lane_plan in plans:
                known |= {str(column["id"]) for column in lane_plan["columns"]}
            for issue in issues:
                issue_id = str(issue.get("id") or "")
                if not issue_id:
                    continue
                status = str(issue.get("status") or "")
                try:
                    runs = rows_of(live.json(["issue", "runs", issue_id, "--active"]), "issue runs")
                except Fail:
                    runs = []
                if runs:
                    running.add(issue_id)
                    started, queued = active_stamps(runs)
                    if started:
                        active_start[issue_id] = started
                    if queued:
                        queued_since[issue_id] = queued
                try:
                    rows = rows_of(live.json(["issue", "label", "list", issue_id]), "issue label list")
                except Fail:
                    rows = []
                labels[issue_id] = {str(row.get("name") or "") for row in rows if row.get("name")}
                if status in known:
                    try:
                        events = rows_of(
                            live.json(["issue", "timeline", issue_id, "--tail", "200"]), "issue timeline"
                        )
                    except Fail:
                        events = []
                    over = back_edge_findings(events, groups, limit)
                    if over:
                        spent[issue.get("key") or issue_id] = over
            unmarked, unassigned, orphans, stale = board_findings(
                issues, gate_ids(groups), known, running, labels)
            # Only a failing check needs a sentence: printing "waiting on a person: "
            # with nobody waiting reads as a warning that is not there.
            check("no gate card waits unmarked", not unmarked,
                  "waiting on a person: " + ", ".join(unmarked[:4]) if unmarked else "")
            check("every waiting card is assigned to a person", not unassigned,
                  "nobody owns: " + ", ".join(unassigned[:4]) if unassigned else "")
            check("no orphaned card", not orphans,
                  "run ended, nothing queued: " + ", ".join(orphans[:4]) if orphans else "")
            check("no stale waiting marker", not stale, ", ".join(stale[:4]))
            detail = "; ".join(
                f"{key}: " + ", ".join(f"{src}→{dst} x{n}" for src, dst, n in pairs)
                for key, pairs in list(spent.items())[:3]
            )
            check(f"no card over {limit} back-edge(s)", not spent, detail or "")
            idle_limit = float(load_policy().get("max_idle_hours", 48))
            stalled = stalled_cards(issues, known, idle_limit)
            idle_detail = ", ".join(f"{key} ({status}, {hours}h)" for key, status, hours in stalled[:4])
            check(f"no card idle beyond {idle_limit:g}h", not stalled, idle_detail)
            run_limit = float(load_policy().get("max_run_minutes", 90))
            queue_limit = float(load_policy().get("max_queue_minutes", 10))
            zombies = zombie_runs(issues, active_start, run_limit)
            zombie_detail = ", ".join(f"{key} ({age:g} min)" for key, age in zombies[:4])
            check(f"no run older than {run_limit:g} min", not zombies, zombie_detail)
            # A queued run that never starts is invisible everywhere else: it counts
            # as active, so the card is no orphan, and it has no `started_at`, so it
            # is no zombie. A daemon restart stranded a card exactly this way.
            stranded = zombie_runs(issues, queued_since, queue_limit)
            stranded_detail = ", ".join(f"{key} ({age:g} min)" for key, age in stranded[:4])
            check(f"no run queued longer than {queue_limit:g} min", not stranded, stranded_detail)
            stale_idle = [key for key, _status, _hours in stalled]
            park = unmarked + [key for key in spent if key not in unmarked]
            park += [key for key, _age in zombies if key not in park]
            park += [key for key, _age in stranded if key not in park]
            park += [key for key in stale_idle if key not in park]
            if getattr(args, "fix", False):
                by_key = {issue.get("key"): issue for issue in issues}
                gates_now = gate_ids(groups) | loose_gate_ids()
                restart_after = f"{int(float(load_policy().get('stall_minutes', 5)))}m"
                marked = restarted = 0
                for key in park:
                    issue_id = str((by_key.get(key) or {}).get("id") or "")
                    if not issue_id:
                        continue
                    live.run(["issue", "label", "add", issue_id, HUMAN_GATE_MARKER], can_fail=True)
                    assign_owner(live, by_key.get(key) or {}, host)
                    live.run(["issue", "wakeup", "create", issue_id, "--after", "45m",
                              "--instruction", WAITING_NUDGE], can_fail=True)
                    marked += 1
                for key in orphans:
                    issue = by_key.get(key) or {}
                    issue_id = str(issue.get("id") or "")
                    if not issue_id:
                        continue
                    if str(issue.get("status") or "") in gates_now | {"todo"}:
                        # Nothing in a gate or in the entry column can start by
                        # itself, so the only honest action is to tell a person.
                        live.run(["issue", "label", "add", issue_id, HUMAN_GATE_MARKER], can_fail=True)
                        live.run(["issue", "wakeup", "create", issue_id, "--after", "45m",
                                  "--instruction", WAITING_NUDGE], can_fail=True)
                        marked += 1
                    else:
                        # An agent column with no run is a stage that stopped. Two
                        # real stalls on the smoke card (27 minutes in design, 45
                        # in verify) were only restarted because a person noticed.
                        live.run(["issue", "wakeup", "create", issue_id, "--after", restart_after,
                                  "--instruction", STALL_NUDGE], can_fail=True)
                        restarted += 1
                if marked or restarted:
                    say(f"fix: {marked} card(s) marked and nudged, {restarted} stage(s) restarted")
    if offline:
        check("offline", True, "network and live-workspace checks skipped")

    width = max(len(name) for name, _, _ in checks)
    for name, ok, detail in checks:
        say(f"  {'OK ' if ok else 'FAIL'}  {name:{width}s}  {detail}")
    failed = [name for name, ok, _ in checks if not ok]
    say()
    if failed:
        say(f"doctor: {len(failed)} check(s) failed")
        return 1
    say("doctor: all checks passed")
    return 0


def ensure_skill(multica: Multica, host: dict, skill: str, refresh: bool) -> None:
    repo = host["stelow"]["repo"]
    ref = host["stelow"]["ref"]
    root = host["stelow"].get("skill_root") or "skills"
    live = multica.skills()
    if skill in live:
        if refresh:
            code, _, err = multica.run(["skill", "refresh", live[skill]], can_fail=True)
            if code != 0:
                say(f"  ! refresh {skill}: {err.strip()[:160]} (kept existing)")
        return
    url = f"https://github.com/{repo}/tree/{ref}/{root}/{skill}"
    multica.run(["skill", "import", "--url", url, "--on-conflict", "skip"])
    live = multica.skills()
    if skill not in live:
        raise Fail(f"import of {skill} did not register it — check {url}")
    say(f"  + skill {skill}")


def ensure_agent(multica: Multica, host: dict, agent: str, skills: list[str], skill_ids: dict[str, str]) -> str:
    name = agent_name(host, agent)
    body = "\n\n".join([
        (ROOT / "agents" / "_adapter.md").read_text(encoding="utf-8").strip(),
        (ROOT / "agents" / f"{agent}.md").read_text(encoding="utf-8").strip(),
    ])
    description = f"{agent} column handler {host['agents'].get('description_suffix') or '(stelow)'}"
    live = multica.agents()
    if name in live:
        agent_id = live[name]
        common = ["--instructions", body, "--description", description]
        model = host["multica"].get("model") or ""
        if model:
            common += ["--model", model]
        runtime = host["multica"].get("runtime_id") or ""
        if runtime:
            # Config is authoritative: a stale runtime id is the quiet way an
            # agent ends up bound to a machine that will never take the run.
            common += ["--runtime-id", runtime]
        multica.run(["agent", "update", agent_id] + common)
    else:
        create = ["agent", "create", "--name", name, "--instructions", body, "--description", description]
        runtime = host["multica"].get("runtime_id") or ""
        if not runtime:
            raise Fail("multica.runtime_id is required to create agents (config/host.json)")
        create += ["--runtime-id", runtime]
        if host["multica"].get("model"):
            create += ["--model", host["multica"]["model"]]
        if host["multica"].get("thinking_level"):
            create += ["--thinking-level", host["multica"]["thinking_level"]]
        if host["agents"].get("permission"):
            create += ["--permission-mode", host["agents"]["permission"]]
        payload = multica.json(create)
        agent_id = multica._one(payload, "agent create")["id"]
        say(f"  + agent {name}")
    ids = [skill_ids[s] for s in skills if s in skill_ids]
    multica.run(["agent", "skills", "set", agent_id, "--skill-ids", ",".join(ids)])
    return agent_id


def resolve_project(multica: Multica, name: str) -> str:
    """A project id from a title or an id prefix.

    `project workflow set` takes an id, and a board names its project by title, so
    the id has to be looked up rather than assumed. An empty answer is a project
    that does not exist yet.
    """
    try:
        rows = rows_of(multica.json(["project", "list"]), "project list")
    except Fail:
        return ""
    for row in rows:
        project_id = str(row.get("id") or "")
        title = str(row.get("title") or row.get("name") or "")
        if title == name or (project_id and project_id.startswith(name.lower())):
            return project_id
    return ""


def load_projects() -> list[dict]:
    path = ROOT / "config" / "projects.json"
    if not path.is_file():
        return []
    return json.loads(path.read_text()).get("projects") or []


def workflow_name_of(payload) -> str:
    """The workflow's name out of either shape the CLI returns.

    `project workflow get` answers with the whole workflow object; `project
    workflow set` answers with `{"workflow": "<name>"}`. Reading only one shape
    makes every check fail on the correct case, which is how this shipped once.
    """
    if isinstance(payload, str):
        return payload.strip()
    if not isinstance(payload, dict):
        return ""
    inner = payload.get("workflow")
    if isinstance(inner, dict):
        return str(inner.get("name") or "")
    if isinstance(inner, str) and inner:
        return inner
    return str(payload.get("name") or payload.get("workflow_name") or "")


def project_workflow(multica: Multica, project_id: str) -> str:
    try:
        return workflow_name_of(multica.json(["project", "workflow", "get", project_id]))
    except Fail:
        return ""


def scope_args(args, entry: dict):
    """One declaration's view of the same command line."""
    scoped = copy.copy(args)
    scoped.board = entry.get("board")
    scoped.project = entry["project"]
    scoped.intent = entry.get("intent", "feature")
    scoped.gates = entry.get("gates", "human")
    scoped.create_project = True
    return scoped


def check_projects(host: dict, projections, groups, lock) -> int:
    multica = Multica(host)
    failed = 0
    for entry in projections:
        args = scope_args(
            type("Args", (), {"json": False, "offline": True})(), entry
        )
        plan = resolve_plan(host, args, groups, lock)
        project_id = resolve_project(multica, entry["project"])
        if not project_id:
            say(f"  MISSING  {entry['project']:<9} project does not exist; run install")
            failed += 1
            continue
        live = project_workflow(multica, project_id)
        if live == plan["workflow"]:
            say(f"  OK       {entry['project']:<9} {live}")
        else:
            say(f"  FAIL     {entry['project']:<9} runs {live or '(nothing)'}, declaration says {plan['workflow']}")
            failed += 1
    return 1 if failed else 0


def install_targets(host: dict, args) -> list[str]:
    """Which containers get the workflow.

    One workflow serves every container, so the question is never "which flow for
    this repo". `--all-projects` covers a workspace where each repository is a
    project; without it, the one named by env or by `--project`.
    """
    if getattr(args, "all_projects", False):
        rows = rows_of(Multica(host).json(["project", "list"]), "project list")
        return [str(row.get("title") or row.get("name")) for row in rows if row.get("title") or row.get("name")]
    if getattr(args, "project", None):
        return [str(args.project)]
    env = host["multica"].get("project_id") or ""
    return [env] if env else ["stelow"]


def workflow_step_keys(payload: dict) -> set[str]:
    """The status keys a workflow defines, whatever shape the API answers in."""
    keys = set()
    for step in payload.get("steps") or []:
        if not isinstance(step, dict):
            status = str(step)
        else:
            status = step.get("status_key") or step.get("status") or ""
            if isinstance(status, dict):
                status = status.get("key") or status.get("name") or ""
        if status:
            keys.add(str(status))
    return keys


def check_install(host: dict, args, groups, lock) -> int:
    plans = install_plans(host, args, groups, lock)
    multica = Multica(host)
    try:
        live_agents = {str(row.get("name")): str(row.get("id")) for row in rows_of(multica.json(["agent", "list"]), "agent list")}
    except Fail:
        live_agents = {}
    failed = 0
    for plan in plans:
        name = plan["workflow"]
        want = workflow_step_keys({"steps": build_steps(plan, host, IdMap(live_agents), create=False)})
        try:
            live = multica.json(["workflow", "get", name])
        except Fail as exc:
            say(f"  MISSING workflow {name}: {str(exc).splitlines()[0][:80]}")
            failed = 1
            continue
        have = workflow_step_keys(live)
        missing = sorted(want - have)
        say(f"  {'OK  ' if not missing else 'FAIL'} {name:<16} {len(have)} step(s)"
            + (f"; missing {', '.join(missing[:6])}" if missing else ""))
        failed += 1 if missing else 0
    targets = [(plan["project"], plan["workflow"]) for plan in plans if plan.get("_board")]
    targets += [(project, plans[0]["workflow"]) for project in install_targets(host, args)]
    for project, workflow in targets:
        project_id = resolve_project(multica, project)
        if not project_id:
            say(f"  MISSING  {project:<16} project does not exist; run install")
            failed = 1
            continue
        live_name = workflow_name_of(multica.json(["project", "workflow", "get", project_id]))
        ok = live_name == workflow
        say(f"  {'OK  ' if ok else 'FAIL'} {project:<16} {live_name or '(none)'}"
            + ("" if ok else f" expected {workflow}"))
        failed += 0 if ok else 1
    return 1 if failed else 0


def cmd_install(host: dict, args, groups, lock) -> int:
    """Converge the three workflows and bind each to the projects it serves.

    A tracker binds one workflow to a container, so the shapes are three workflows
    rather than three tracks in one graph: the chain is the flow that edits code and
    gets a project per repository, while explore and research are questions about
    repositories and each owns one shared project.
    """
    install = load_install()
    if getattr(args, "check", False):
        return check_install(host, args, groups, lock)
    scoped = copy.copy(args)
    scoped.install = True
    scoped.project = ""
    scoped.intent = "feature"
    if cmd_apply(host, scoped, groups, lock) != 0:
        return 1
    chain = install["workflows"][0]["id"]
    multica = Multica(host)
    for target in install_targets(host, args):
        project_id = resolve_project(multica, target)
        if not project_id:
            multica.run(["project", "create", "--title", target,
                         "--description", f"{chain}: one idea carried to shipped code"])
            project_id = resolve_project(multica, target)
        if not project_id:
            raise Fail(f"project {target!r} could not be created or found")
        multica.run(["project", "workflow", "set", project_id, chain])
        say(f"  = {target} -> {chain}")
    return 0


ASK_TEMPLATE = """**Question:** {question}

**Strategy:** {skill}
**By when it matters:** {when}

House rules: one skill, one artifact, one page. Cite or say you do not know.
"""


def ask_project(host: dict, args, fallback: str) -> str:
    """The container a question lands in: the one named, the one in env, or its own."""
    if getattr(args, "project", None):
        return str(args.project)
    env = host["multica"].get("project_id") or ""
    return env or fallback


def cmd_ask(host: dict, args, groups) -> int:
    """Put one question on a track, with the strategy already named.

    A question asked through this command wants an answer, not a triage step, so
    it lands in the lane's first column and names its strategy on the card.
    """
    track = str(args.board)
    entry = track_entry(track)
    multica = Multica(host)
    question = " ".join(args.question).strip()
    skill = ""
    if track == "build":
        project = ask_project(host, args, "stelow")
        body = f"**What is wanted:** {question}\n\n{args.when or ''}".rstrip() + "\n"
    else:
        board = load_board(track)
        project = ask_project(host, args, board["project"])
        skill = args.skill or ""
        if skill:
            prefix = board["skill_prefix"]
            if not skill.startswith(prefix):
                skill = prefix + skill
            if skill not in {item["skill"] for item in board["menu"]}:
                names = ", ".join(sorted(item["skill"].replace(prefix, "") for item in board["menu"]))
                raise Fail(f"{skill} is not on the {track} menu. On it: {names}")
        body = ASK_TEMPLATE.format(
            question=question,
            skill=skill or "(the runner picks from the menu and says why)",
            when=args.when or "when the decision is needed",
        )
    project_id = resolve_project(multica, project)
    if not project_id:
        raise Fail(f"project {project!r} does not exist; run install --all-projects first")
    title = args.title or question[:70]
    if args.dry_run:
        say(f"would create {title!r} on {project}/{entry} with strategy={skill or 'the chain decides'}")
        return 0
    body_path = ROOT / ".stelow-cache" / "ask.md"
    body_path.parent.mkdir(parents=True, exist_ok=True)
    body_path.write_text(body)
    created = multica.json([
        "issue", "create", "--project", project_id, "--title", title,
        "--description-file", str(body_path),
    ])
    issue_id = str(created.get("id") or "")
    if not issue_id:
        raise Fail("the issue was created but its id could not be read")
    multica.run(["issue", "status", issue_id, entry])
    say(f"{created.get('key') or issue_id}  -> {project}/{entry}  strategy={skill or 'the chain decides'}")
    return 0


STATUS_COLORS = {
    "backlog": "#6b7280",
    "unstarted": "#9ca3af",
    "started": "#3b82f6",
    "done": "#10b981",
    "closed": "#ef4444",
}


def cmd_apply(host: dict, args, groups, lock) -> int:
    failed = 0
    for plan in resolve_plans(host, args, groups, lock):
        failed += apply_plan(host, args, plan)
    return 1 if failed else 0


def cmd_verify(host: dict, args, groups, lock) -> int:
    failed = 0
    for plan in resolve_plans(host, args, groups, lock):
        failed += verify_plan(host, args, plan)
    return 1 if failed else 0


def cmd_status(host: dict, args, groups, lock) -> int:
    failed = 0
    for plan in resolve_plans(host, args, groups, lock):
        failed += status_plan(host, args, plan, lock)
    return 1 if failed else 0


def ensure_statuses(multica: Multica, plan: dict) -> int:
    """Workspace statuses first, then the workflow that wires them.

    A workflow is a graph over workspace-level statuses, and a step pointing at a
    status created in the same request is rejected. Creating them first also means
    replacing a workflow never drops a column a card is sitting in.
    """
    live = {str(row.get("key") or "") for row in rows_of(multica.json(["issue-status", "list"]), "issue-status list")}
    added = 0
    for column in plan["columns"]:
        key = str(column["id"])
        if not key or key in live:
            continue
        category = str(column.get("category") or "started")
        multica.run([
            "issue-status", "create", "--key", key, "--name", str(column.get("label") or key),
            "--category", category, "--color", STATUS_COLORS.get(category, "#3b82f6"),
        ])
        added += 1
    return added


def apply_plan(host: dict, args, plan: dict) -> int:
    preflight(host)
    if not getattr(args, "offline", False):
        # Before the first write: a bad skill name would otherwise fail the run
        # with half the skills already imported.
        missing = missing_upstream(host, plan["skills"])
        if missing:
            raise Fail(
                "not at the pinned path in "
                f"{host['stelow']['repo']}@{host['stelow']['ref']}: {', '.join(missing)}"
            )
    multica = Multica(host)
    say(f"applying {plan['workflow']} (intent={plan['intent']}, gates={plan['gates']})")
    for skill in plan["skills"]:
        ensure_skill(multica, host, skill, args.refresh_skills)
    skill_ids = multica.skills()
    agent_ids: dict[str, str] = {}
    for agent in plan["agents"]:
        agent_ids[agent_name(host, agent["agent"])] = ensure_agent(
            multica, host, agent["agent"], agent["skills"], skill_ids)
    exists = plan["workflow"] in multica.workflows()
    added = ensure_statuses(multica, plan)
    if added:
        say(f"  + {added} workspace status(es) created before the workflow")
    steps = build_steps(plan, host, agent_ids, create=False)
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
        json.dump(steps, handle, indent=2)
        steps_path = handle.name
    if exists:
        multica.run(["workflow", "update", plan["workflow"], "--steps-file", steps_path])
        say(f"  = workflow {plan['workflow']} (steps replaced)")
    else:
        multica.run([
            "workflow", "create", "--name", plan["workflow"], "--steps-file", steps_path,
            "--description", f"stelow {plan['intent']} chain ({plan['gates']} gates)",
        ])
        say(f"  + workflow {plan['workflow']}")
    if plan["project"]:
        project_ref = resolve_project(multica, plan["project"])
        may_create = plan.get("_board") or getattr(args, "create_project", False)
        if not project_ref and may_create:
            multica.run([
                "project", "create", "--title", plan["project"],
                "--description", f"stelow {plan['intent']}: declared in stelow-host-multica",
            ])
            say(f"  + project {plan['project']}")
            project_ref = resolve_project(multica, plan["project"])
        if not project_ref:
            raise Fail(
                f"no project called {plan['project']!r} in this workspace: create it, or pass --project <id>"
            )
        cmd = ["project", "workflow", "set", project_ref, plan["workflow"]]
        if args.migrate:
            for old, new in (host.get("migrate") or {}).items():
                if old.startswith("_") or not new:
                    continue
                if new in {c["id"] for c in plan["columns"]} or new in {"todo", "done"}:
                    cmd += ["--map", f"{old}={new}"]
        multica.run(cmd)
        say(f"  = project {plan['project']} → {plan['workflow']}")
    say("done.")
    return 0


def verify_plan(host: dict, args, plan: dict) -> int:
    multica = Multica(host)
    problems: list[str] = []
    live_skills = multica.skills()
    live_agents = multica.agents()
    for skill in plan["skills"]:
        if skill not in live_skills:
            problems.append(f"skill missing: {skill}")
    agent_ids: dict[str, str] = {}
    for agent in plan["agents"]:
        name = agent_name(host, agent["agent"])
        if name not in live_agents:
            problems.append(f"agent missing: {name}")
            continue
        agent_ids[name] = live_agents[name]
        expected = {live_skills[s] for s in agent["skills"] if s in live_skills}
        actual = set(multica.agent_skill_ids(live_agents[name]))
        if expected - actual:
            problems.append(f"{name}: missing skills {sorted(expected - actual)}")
        if actual - expected:
            problems.append(f"{name}: unexpected skills {sorted(actual - expected)}")
    resolve = {agent_name(host, a["agent"]): agent_ids.get(agent_name(host, a["agent"]), f"<missing:{a['agent']}>") for a in plan["agents"]}
    wf = multica.workflow(plan["workflow"])
    if wf is None:
        problems.append(f"workflow missing: {plan['workflow']}")
    else:
        raw_steps = wf.get("steps") if isinstance(wf, dict) else wf
        live_steps = rows_of(raw_steps, "workflow get") if raw_steps else []
        if not live_steps:
            problems.append(f"workflow {plan['workflow']} exposes no steps")
        expected_steps = build_steps(plan, host, resolve, create=False)
        want = [s.get("status_key") for s in expected_steps]
        # Multica appends its own terminal statuses (cancelled) to every
        # workflow. A built-in column we never asked for is not drift; a custom
        # one is.
        got = [
            s.get("status_key")
            for s in live_steps
            if s.get("status_key") in want or s.get("status_key") not in RESERVED
        ]
        live_by_key = {s.get("status_key"): s for s in live_steps}
        if got != want:
            problems.append(f"workflow steps differ: want {want} got {got}")
        else:
            for want_step in expected_steps:
                got_step = live_by_key.get(want_step.get("status_key")) or {}
                want_next = want_step.get("next_status_key")
                if want_next and got_step.get("next_status_key") != want_next:
                    problems.append(f"{want_step['status_key']}: next is {got_step.get('next_status_key')!r}, want {want_next!r}")
                want_back = want_step.get("back_status_key")
                if want_back and got_step.get("back_status_key") != want_back:
                    problems.append(f"{want_step['status_key']}: back is {got_step.get('back_status_key')!r}, want {want_back!r}")
                live_handler = got_step.get("handler") if isinstance(got_step.get("handler"), dict) else {}
                want_handler = want_step.get("handler") or {}
                # The API spells "nothing happens here" as {"type": "none"}, while
                # a bookend step simply omits the field. Same meaning, and
                # comparing the raw values reported drift on todo and done.
                want_type = want_handler.get("type") or "none"
                live_type = live_handler.get("type") or "none"
                if want_type != live_type or (
                    want_handler.get("id") and want_handler.get("id") != live_handler.get("id")
                ):
                    label = want_handler.get("type") or "none"
                    problems.append(
                        f"{want_step['status_key']}: handler is {live_handler.get('type')!r}, want {label!r}"
                    )
    if plan["project"]:
        # A lane's project is named, not identified: `project workflow get` answers
        # about an id, so passing the title asked about a project that does not exist
        # and reported a converged lane as drift.
        project_id = resolve_project(multica, plan["project"]) or ""
        if not project_id:
            problems.append(f"project {plan['project']} does not exist")
        else:
            current = multica.project_workflow(project_id)
            text = json.dumps(current or {})
            if plan["workflow"] not in text:
                problems.append(f"project {plan['project']} does not use {plan['workflow']}")
    if problems:
        say(f"DRIFT ({len(problems)})")
        for problem in problems:
            say(f"  ! {problem}")
        say("run `apply` to converge.")
        return 1
    say(f"ok: {plan['workflow']} matches the plan ({len(plan['skills'])} skills, {len(plan['agents'])} agents)")
    return 0


def status_plan(host: dict, args, plan: dict, lock: dict) -> int:
    multica = Multica(host)
    live_skills = multica.skills()
    live_agents = multica.agents()
    live_wf = multica.workflows()
    say(f"stelow  ref={lock['ref']}  stages.sha256={str(lock.get('stages_sha256') or lock.get('sha') or '?')[:12]}")
    say(f"skills  {sum(1 for s in plan['skills'] if s in live_skills)}/{len(plan['skills'])} of this intent present "
        f"({len(live_skills)} in workspace)")
    say(f"agents  {sum(1 for a in plan['agents'] if agent_name(host, a['agent']) in live_agents)}/{len(plan['agents'])} of this intent present "
        f"({len(live_agents)} in workspace)")
    say(f"workflow {'present' if plan['workflow'] in live_wf else 'MISSING'}: {plan['workflow']}")
    say(f"columns  {' → '.join(['todo'] + [c['id'] for c in plan['columns']] + ['done'])}")
    return 0


# ------------------------------------------------------------------------ cli


def main(argv: list[str]) -> int:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--intent", default=None,
                        help="intent route from stages.yaml (default: config default)")
    common.add_argument("--gates", choices=["human", "agent"], default=None,
                        help="gate handler: the project lead (human) or the review agent")
    common.add_argument("--project", default=None, help="Multica project id")
    common.add_argument("--json", action="store_true")
    common.add_argument("--workflow", dest="workflow_name", default=None,
                        help="only this workflow (default: the chain)")
    common.add_argument("--all-workflows", dest="all_workflows", action="store_true",
                        help="every declared workflow: chain, explore, research")
    common.add_argument("--refresh-skills", action="store_true", help="re-pull imported skills from their source")
    common.add_argument("--migrate", action="store_true", help="pass --map for built-in statuses when switching the project")
    common.add_argument("--offline", action="store_true", help="skip checks that need the network or the live workspace")

    parser = argparse.ArgumentParser(prog="stelow-host", description="Provision stelow onto Multica.")
    parser.add_argument("--config", default=str(ROOT / "config" / "host.json"))
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("sync", help="fetch and pin stages.yaml", parents=[common])
    plan_cmd = sub.add_parser("plan", help="show what would change", parents=[common])
    plan_cmd.add_argument("--board", help="render boards/<name>.json instead of the stage chain")
    apply_cmd = sub.add_parser("apply", help="converge the workspace", parents=[common])
    apply_cmd.add_argument("--board", help="converge boards/<name>.json instead of the stage chain")
    apply_cmd.add_argument("--all", action="store_true", help="converge every project in config/projects.json")
    install_cmd = sub.add_parser(
        "install", help="converge every declared workflow and bind each to its projects", parents=[common])
    install_cmd.add_argument("--check", action="store_true", help="verify the workflow and the projects, writing nothing")
    install_cmd.add_argument("--all-projects", dest="all_projects", action="store_true",
                             help="attach the workflow to every project, as one project per repository")
    ask_cmd = sub.add_parser("ask", help="put one question on a board, with the strategy named", parents=[common])
    ask_cmd.add_argument("board", help="explore or research")
    ask_cmd.add_argument("question", nargs="+", help="the question, in one sentence")
    ask_cmd.add_argument("--skill", help="a skill name or just its tail, e.g. pricing")
    ask_cmd.add_argument("--when", help="by when it matters")
    ask_cmd.add_argument("--title", help="override the derived title")
    ask_cmd.add_argument("--dry-run", action="store_true", help="print what would be created")
    board_cmd = sub.add_parser("board", help="check a board declaration without touching the workspace", parents=[common])
    board_cmd.add_argument("names", nargs="*", help="board names; default is every file in boards/")
    sub.add_parser("verify", help="assert the live workspace matches the plan", parents=[common])
    sub.add_parser("status", help="compact live summary", parents=[common])
    card = sub.add_parser("card", help="what a card kept, and where it stopped", parents=[common])
    card.add_argument("issue", help="issue id or key")
    park = sub.add_parser("park", help="mark a card as waiting on a person, and assign it to them",
                          parents=[common])
    park.add_argument("issue", help="issue id or key")
    park.add_argument("--why", default="", help="one line on what is owed, posted as a comment")
    park.add_argument("--wake", default="", help="re-check after this delay, e.g. 45m")
    doctor = sub.add_parser("doctor", help="check the environment, the pin, stage ownership, and the board", parents=[common])
    doctor.add_argument("--fix", action="store_true", help="mark cards that wait on a person without saying so")
    args = parser.parse_args(argv)

    try:
        config_path = Path(args.config)
        set_root(config_path.parent.parent)
        host = load_host(config_path)
        host.setdefault("defaults", {})
        args.intent = args.intent or host["defaults"].get("intent") or "feature"
        args.gates = args.gates or host["defaults"].get("gates") or "human"
        args.project = args.project or host["multica"].get("project_id") or ""
        groups = load_groups(ROOT / "config" / "columns.json")
        if args.command == "sync":
            return cmd_sync(host, args)
        lock = ensure_stages(host, force=False)
        if args.command == "plan":
            return cmd_plan(host, args, groups, lock)
        if args.command == "apply":
            return cmd_apply(host, args, groups, lock)
        if args.command == "verify":
            return cmd_verify(host, args, groups, lock)
        if args.command == "status":
            return cmd_status(host, args, groups, lock)
        if args.command == "board":
            return cmd_board(host, args)
        if args.command == "install" or (args.command == "apply" and getattr(args, "all", False)):
            return cmd_install(host, args, groups, lock)
        if args.command == "ask":
            return cmd_ask(host, args, groups)
        if args.command == "card":
            return cmd_card(host, args, groups)
        if args.command == "park":
            return cmd_park(host, args)
        if args.command == "doctor":
            return cmd_doctor(host, args, groups, lock)
        raise Fail(f"unknown command {args.command}")
    except Fail as exc:
        print(f"stelow-host: {exc}", file=sys.stderr)
        return exc.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
